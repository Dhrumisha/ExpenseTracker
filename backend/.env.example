# Copy this file to .env for local development.
# In production (Vercel), set these under Project Settings -> Environment
# Variables instead of committing them anywhere - never put real secrets
# in vercel.json or any tracked file.

# PostgreSQL connection
PGHOSTNAME=127.0.0.1
PGUSERNAME=postgres
PGPASSWORD=changeme
PGDATABASE=expensetracker
PGPORT=5432

# Long, random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# SMTP settings used to send password-reset emails.
# Using Resend (https://resend.com): sign up free, create an API key, then:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=465
#   EMAIL_USERNAME=resend               (literal string, not your email)
#   EMAIL_PASSWORD=<your Resend API key, starts with re_>
#   EMAIL_FROM=Expense Tracker <onboarding@resend.dev>
# Note: onboarding@resend.dev can only deliver to the email you signed up
# with, until you verify your own domain in the Resend dashboard.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Comma-separated list of origins allowed to call this API with credentials
# (no trailing slash). Include every frontend URL that needs access:
# production, any custom domain, and localhost for local dev.
FRONTEND_URL=http://localhost:3000
