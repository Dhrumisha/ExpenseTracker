{
    "version": 2,
    "builds": [
        {
            "src": "server.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server.ts"
        }
    ],
    "env": {
        "PGHOSTNAME": "127.0.0.1",
        "PGUSERNAME": "postgres",
        "PGPASSWORD": "12345678",
        "PGDATABASE": "expensetracker",
        "PGPORT": "5432",
        "JWT_SECRET": "***REMOVED-JWT-SECRET***",
        "EMAIL_USERNAME": "***REMOVED-EMAIL-USERNAME***",
        "EMAIL_PASSWORD": "***REMOVED-EMAIL-PASSWORD***",
        "EMAIL_HOST": "sandbox.smtp.mailtrap.io",
        "EMAIL_PORT": "2525",
        "FRONTEND_URL": "http://localhost:3000"
    }
}