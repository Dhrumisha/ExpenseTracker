# Copy this file to .env.local for local development.
# In production (Vercel), set this under Project Settings -> Environment
# Variables for Production, Preview, and Development.

# Origin of the backend API (no /api/v1 suffix, no trailing slash). The
# frontend never calls this directly from the browser - next.config.ts
# rewrites /api/v1/* requests to this origin server-side, so the browser
# only ever talks to the frontend's own domain. This is what lets the
# backend's httpOnly auth cookies actually be visible to this app; setting
# the old NEXT_PUBLIC_BASE_URL to the backend's domain and calling it
# directly meant the cookie was scoped to that other domain instead.
# Example: https://expense-tracker-backend.vercel.app
BACKEND_URL=http://localhost:5000
