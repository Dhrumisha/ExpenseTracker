# Copy this file to .env.local for local development.
# In production (Vercel), set this under Project Settings -> Environment
# Variables for Production, Preview, and Development.

# Base URL of the backend API, including its /api/v1 prefix, no trailing
# slash. Example: https://expense-tracker-backend.vercel.app/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:5000/api/v1
